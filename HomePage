<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Just The Guy Gutters & Exteriors | Seamless Gutters & Gutter Screens
    </title>

    <meta
        name="description"
        content="Just The Guy Gutters & Exteriors provides 5-inch and 6-inch seamless gutters, gutter screens, gutter repairs and exterior services throughout Mid-Michigan."
    >

    <meta
        name="keywords"
        content="seamless gutters, gutter screens, gutter guards, gutter installation, gutter repair, Durand MI, Mid Michigan gutters"
    >

    <meta name="theme-color" content="#06285C">

    <style>

        /* =========================================================
           JUST THE GUY GUTTERS & EXTERIORS
           ========================================================= */

        :root {
            --blue: #1762B5;
            --dark-blue: #06285C;
            --deep-blue: #031B40;
            --green: #2C9622;
            --green-dark: #237A1B;
            --green-light: #EAF6E8;

            --white: #FFFFFF;
            --off-white: #F7F9FC;
            --light-gray: #EEF2F6;
            --gray: #667085;
            --dark: #172033;

            --border: #DCE3EA;

            --shadow:
                0 18px 50px rgba(6, 40, 92, 0.12);

            --radius: 14px;
        }


        /* =========================================================
           RESET
           ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family:
                Arial,
                Helvetica,
                sans-serif;

            color: var(--dark);
            background: var(--white);

            line-height: 1.6;

            overflow-x: hidden;
        }

        img {
            max-width: 100%;
            display: block;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button,
        input,
        textarea,
        select {
            font: inherit;
        }

        button {
            cursor: pointer;
        }


        /* =========================================================
           GLOBAL
           ========================================================= */

        .container {
            width: min(1180px, 92%);
            margin: 0 auto;
        }

        .section {
            padding: 90px 0;
        }

        .section-light {
            background: var(--off-white);
        }

        .section-dark {
            background: var(--dark-blue);
            color: white;
        }

        .section-label {
            display: inline-block;

            color: var(--green);

            font-size: 13px;
            font-weight: 900;

            text-transform: uppercase;
            letter-spacing: 1.7px;

            margin-bottom: 12px;
        }

        .section-title {
            color: var(--dark-blue);

            font-size:
                clamp(34px, 5vw, 52px);

            line-height: 1.08;

            margin-bottom: 20px;
        }

        .section-description {
            color: var(--gray);

            max-width: 700px;

            font-size: 17px;
        }

        .center {
            text-align: center;
        }

        .center .section-description {
            margin-left: auto;
            margin-right: auto;
        }


        /* =========================================================
           BUTTONS
           ========================================================= */

        .button {
            display: inline-flex;

            align-items: center;
            justify-content: center;

            min-height: 52px;

            padding:
                14px 24px;

            border-radius: 8px;

            font-weight: 900;

            border: 2px solid transparent;

            transition:
                transform .2s ease,
                background .2s ease,
                box-shadow .2s ease;
        }

        .button:hover {
            transform: translateY(-2px);
        }

        .button-green {
            background: var(--green);
            color: white;

            box-shadow:
                0 8px 22px rgba(44, 150, 34, .25);
        }

        .button-green:hover {
            background: var(--green-dark);
        }

        .button-blue {
            background: var(--blue);
            color: white;
        }

        .button-blue:hover {
            background: #10529D;
        }

        .button-outline-white {
            border-color: white;
            color: white;
        }

        .button-outline-white:hover {
            background: white;
            color: var(--dark-blue);
        }


        /* =========================================================
           TOP BAR
           ========================================================= */

        .top-bar {
            background: var(--deep-blue);
            color: white;

            font-size: 13px;
        }

        .top-bar-inner {
            min-height: 38px;

            display: flex;

            justify-content: space-between;
            align-items: center;

            gap: 20px;
        }

        .top-bar a {
            color: white;
            font-weight: 800;
        }

        .top-bar a:hover {
            color: #A9E9A1;
        }


        /* =========================================================
           HEADER
           ========================================================= */

        header {
            position: sticky;
            top: 0;

            z-index: 1000;

            background:
                rgba(255,255,255,.97);

            backdrop-filter:
                blur(12px);

            border-bottom:
                1px solid var(--border);
        }

        .navbar {
            min-height: 82px;

            display: flex;

            align-items: center;

            justify-content: space-between;

            gap: 30px;
        }

        .logo {
            display: flex;

            align-items: center;

            min-width: 210px;
        }

        .logo img {
            width: 205px;
            height: auto;
        }

        nav {
            display: flex;

            align-items: center;

            gap: 24px;
        }

        nav a {
            font-size: 14px;
            font-weight: 800;

            color: var(--dark-blue);

            transition:
                color .2s ease;
        }

        nav a:hover {
            color: var(--green);
        }

        .nav-quote {
            background: var(--green);
            color: white;

            padding:
                12px 18px;

            border-radius: 7px;
        }

        .nav-quote:hover {
            color: white;
            background: var(--green-dark);
        }

        .mobile-menu {
            display: none;

            background: none;
            border: none;

            font-size: 29px;

            color: var(--dark-blue);
        }


       /* =========================================================
   HERO WITH PHOTO CAROUSEL
   ========================================================= */

.hero {
    --hero-image: url("images/project-1.jpg");

    position: relative;
    min-height: 760px;

    display: flex;
    align-items: center;

    overflow: hidden;

    background:
        linear-gradient(
            90deg,
            rgba(3, 27, 64, 0.90) 0%,
            rgba(3, 27, 64, 0.78) 42%,
            rgba(3, 27, 64, 0.48) 100%
        ),
        var(--hero-image)
        center / cover no-repeat;

    transition: background-image 0.8s ease-in-out;
}

/* Dark overlay across the entire image */
.hero::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
        linear-gradient(
            90deg,
            rgba(3, 27, 64, 0.35),
            rgba(3, 27, 64, 0.10)
        );

    pointer-events: none;
}

/* Keeps the actual content above the background */
.hero-inner {
    position: relative;
    z-index: 2;

    width: 100%;

    display: grid;

    grid-template-columns:
        minmax(0, 1fr)
        430px;

    gap: 65px;

    align-items: center;
}

/* =========================================================
   HERO CONTENT
   ========================================================= */

.hero-content {
    color: white;
}

.hero-eyebrow {
    display: inline-block;

    color: #B8ECAE;

    font-size: 14px;
    font-weight: 900;

    text-transform: uppercase;
    letter-spacing: 1.8px;

    margin-bottom: 16px;
}

.hero h1 {
    color: white;

    font-size:
        clamp(44px, 6vw, 72px);

    line-height: 1.01;

    max-width: 760px;

    margin-bottom: 24px;
}

.hero h1 span {
    color: #76D86B;
}

.hero-text {
    color: #E4EBF5;

    font-size: 19px;

    max-width: 650px;

    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;

    flex-wrap: wrap;

    gap: 13px;
}

.hero-trust {
    display: flex;

    flex-wrap: wrap;

    gap: 18px;

    margin-top: 27px;

    color: #D7E3F2;

    font-size: 13px;
    font-weight: 700;
}

.hero-trust span::before {
    content: "✓";

    display: inline-grid;

    place-items: center;

    width: 20px;
    height: 20px;

    margin-right: 6px;

    border-radius: 50%;

    background: var(--green);

    color: white;

    font-size: 12px;
}


/* =========================================================
   CAROUSEL DOTS
   ========================================================= */

.hero-carousel-dots {
    position: absolute;

    z-index: 5;

    left: 50%;
    bottom: 25px;

    transform: translateX(-50%);

    display: flex;

    gap: 9px;
}

.hero-carousel-dot {
    width: 11px;
    height: 11px;

    border-radius: 50%;

    border: 2px solid white;

    background: transparent;

    opacity: 0.75;

    cursor: pointer;

    padding: 0;

    transition:
        background .25s ease,
        transform .25s ease,
        opacity .25s ease;
}

.hero-carousel-dot.active {
    background: white;

    opacity: 1;

    transform: scale(1.2);
}


/* =========================================================
   CAROUSEL ARROWS
   ========================================================= */

.hero-carousel-arrow {
    position: absolute;

    z-index: 5;

    top: 50%;

    transform: translateY(-50%);

    width: 46px;
    height: 46px;

    border-radius: 50%;

    border: 1px solid rgba(255,255,255,.7);

    background: rgba(3,27,64,.35);

    color: white;

    font-size: 26px;

    display: grid;

    place-items: center;

    cursor: pointer;

    transition:
        background .2s ease,
        transform .2s ease;
}

.hero-carousel-arrow:hover {
    background: rgba(44,150,34,.85);

    transform:
        translateY(-50%)
        scale(1.05);
}

.hero-carousel-prev {
    left: 25px;
}

.hero-carousel-next {
    right: 25px;
}


/* =========================================================
   MOBILE HERO
   ========================================================= */

@media (max-width: 850px) {

    .hero {
        min-height: auto;

        padding:
            100px 0
            75px;
    }

    .hero-inner {
        grid-template-columns: 1fr;

        gap: 40px;
    }

    .hero h1 {
        font-size: 50px;
    }

    .hero-carousel-arrow {
        display: none;
    }

    .hero-carousel-dots {
        bottom: 15px;
    }
}


@media (max-width: 600px) {

    .hero {
        padding:
            80px 0
            65px;
    }

    .hero h1 {
        font-size: 40px;
    }

    .hero-text {
        font-size: 16px;
    }

    .hero-buttons {
        flex-direction: column;
    }

    .hero-buttons .button {
        width: 100%;
    }

    .hero-trust {
        flex-direction: column;

        gap: 9px;
    }
}


        /* =========================================================
           QUOTE FORM
           ========================================================= */

        .quote-card {
            background: white;

            padding: 30px;

            border-radius: 16px;

            box-shadow:
                0 30px 80px rgba(0,0,0,.28);
        }

        .quote-card h2 {
            color: var(--dark-blue);

            font-size: 29px;

            line-height: 1.1;

            margin-bottom: 7px;
        }

        .quote-card-intro {
            color: var(--gray);

            font-size: 14px;

            margin-bottom: 20px;
        }

        .form-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 13px;
        }

        .form-group {
            display: flex;

            flex-direction: column;

            gap: 5px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            color: var(--dark);

            font-size: 12px;

            font-weight: 900;
        }

        .required {
            color: #C0392B;
        }

        input,
        select,
        textarea {
            width: 100%;

            padding: 12px 13px;

            border:
                1px solid #CBD5E1;

            border-radius: 7px;

            background: white;

            color: var(--dark);

            outline: none;

            transition:
                border-color .2s ease,
                box-shadow .2s ease;
        }

        input:focus,
        select:focus,
        textarea:focus {
            border-color: var(--blue);

            box-shadow:
                0 0 0 3px
                rgba(23,98,181,.12);
        }

        textarea {
            min-height: 90px;

            resize: vertical;
        }

        input[type="file"] {
            padding: 9px;
        }

        .file-note {
            font-size: 11px;
            color: var(--gray);
        }

        .submit-button {
            width: 100%;

            border: none;

            margin-top: 15px;
        }

        .form-disclaimer {
            color: var(--gray);

            font-size: 10px;

            text-align: center;

            margin-top: 10px;
        }


        /* =========================================================
           TRUST STRIP
           ========================================================= */

        .trust-strip {
            background: var(--dark-blue);

            color: white;

            padding: 22px 0;
        }

        .trust-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;
        }

        .trust-item {
            text-align: center;

            border-right:
                1px solid
                rgba(255,255,255,.14);
        }

        .trust-item:last-child {
            border-right: none;
        }

        .trust-item strong {
            display: block;

            font-size: 16px;
        }

        .trust-item span {
            display: block;

            color: #BFCDE0;

            font-size: 12px;
        }


        /* =========================================================
           INTRO
           ========================================================= */

        .intro-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 70px;

            align-items: center;
        }

        .intro-image {
            min-height: 490px;

            border-radius: 18px;

            background:
                linear-gradient(
                    rgba(6,40,92,.08),
                    rgba(6,40,92,.08)
                ),
                url("images/gutters.jpg")
                center/cover no-repeat;

            box-shadow: var(--shadow);
        }

        .intro-content p {
            color: var(--gray);

            margin-bottom: 17px;
        }

        .feature-list {
            list-style: none;

            margin:
                25px 0 30px;
        }

        .feature-list li {
            display: flex;

            gap: 11px;

            align-items: flex-start;

            margin-bottom: 12px;

            color: #475467;

            font-weight: 600;
        }

        .check {
            flex-shrink: 0;

            display: grid;

            place-items: center;

            width: 23px;
            height: 23px;

            border-radius: 50%;

            background: var(--green);

            color: white;

            font-size: 12px;
            font-weight: 900;
        }


        /* =========================================================
           GUTTER SIZES
           ========================================================= */

        .sizes-section {
            background: var(--off-white);
        }

        .sizes-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 25px;

            margin-top: 45px;
        }

        .size-card {
            position: relative;

            background: white;

            border:
                1px solid var(--border);

            border-radius: 16px;

            padding: 34px;

            overflow: hidden;

            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .size-card:hover {
            transform: translateY(-5px);

            box-shadow: var(--shadow);
        }

        .size-number {
            color: var(--green);

            font-size: 62px;

            line-height: 1;

            font-weight: 900;

            margin-bottom: 8px;
        }

        .size-card h3 {
            color: var(--dark-blue);

            font-size: 28px;

            margin-bottom: 12px;
        }

        .size-card p {
            color: var(--gray);

            margin-bottom: 0;
        }


        /* =========================================================
           GUTTER SCREENS FEATURE
           ========================================================= */

        .screens-section {
            background:
                linear-gradient(
                    115deg,
                    var(--dark-blue),
                    #0A3977
                );

            color: white;
        }

        .screens-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 65px;

            align-items: center;
        }

        .screens-image {
            min-height: 470px;

            border-radius: 18px;

            background:
                url("images/gutter-screens.jpg")
                center/cover no-repeat;

            box-shadow:
                0 25px 65px
                rgba(0,0,0,.3);
        }

        .screens-content .section-label {
            color: #8BE280;
        }

        .screens-content h2 {
            color: white;

            font-size:
                clamp(35px,5vw,53px);

            line-height: 1.06;

            margin-bottom: 20px;
        }

        .screens-content p {
            color: #D5E1F0;

            font-size: 17px;

            margin-bottom: 18px;
        }

        .screen-points {
            list-style: none;

            margin:
                25px 0 30px;
        }

        .screen-points li {
            display: flex;

            gap: 12px;

            color: white;

            margin-bottom: 12px;

            font-weight: 700;
        }


        /* =========================================================
           SERVICES
           ========================================================= */

        .services-heading {
            max-width: 760px;

            margin:
                0 auto 50px;

            text-align: center;
        }

        .services-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 20px;
        }

        .service-card {
            overflow: hidden;

            background: white;

            border:
                1px solid var(--border);

            border-radius: 14px;

            transition:
                transform .2s ease,
                box-shadow .2s ease;
        }

        .service-card:hover {
            transform: translateY(-6px);

            box-shadow: var(--shadow);
        }

        .service-image {
            height: 190px;

            background-position: center;
            background-size: cover;
        }

        .service-gutters {
            background-image:
                url("images/gutters.jpg");
        }

        .service-screens {
            background-image:
                url("images/gutter-screens.jpg");
        }

        .service-repairs {
            background-image:
                url("images/repairs.jpg");
        }

        .service-exterior {
            background-image:
                url("images/project-4.jpg");
        }

        .service-content {
            padding: 24px;
        }

        .service-content h3 {
            color: var(--dark-blue);

            font-size: 21px;

            margin-bottom: 9px;
        }

        .service-content p {
            color: var(--gray);

            font-size: 14px;

            margin-bottom: 17px;
        }

        .service-link {
            color: var(--green);

            font-size: 13px;

            font-weight: 900;

            text-transform: uppercase;

            letter-spacing: .5px;
        }


        /* =========================================================
           PROJECT GALLERY
           ========================================================= */

        .gallery-section {
            background: var(--dark-blue);
        }

        .gallery-heading h2 {
            color: white;
        }

        .gallery-heading p {
            color: #C9D6E7;
        }

        .gallery-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 15px;

            margin-top: 45px;
        }

        .gallery-item {
            position: relative;

            min-height: 270px;

            overflow: hidden;

            border-radius: 12px;

            background:
                linear-gradient(
                    135deg,
                    #315C8E,
                    #17416F
                );

            background-size: cover;
            background-position: center;
        }

        .gallery-item:nth-child(1) {
            background-image:
                url("images/project-1.jpg");
        }

        .gallery-item:nth-child(2) {
            background-image:
                url("images/project-2.jpg");
        }

        .gallery-item:nth-child(3) {
            background-image:
                url("images/project-3.jpg");
        }

        .gallery-item:nth-child(4) {
            background-image:
                url("images/project-4.jpg");
        }

        .gallery-overlay {
            position: absolute;

            left: 0;
            right: 0;
            bottom: 0;

            padding: 45px 18px 18px;

            background:
                linear-gradient(
                    transparent,
                    rgba(0,0,0,.75)
                );

            color: white;
        }

        .gallery-overlay strong {
            font-size: 16px;
        }


        /* =========================================================
           WHAT TO EXPECT
           ========================================================= */

        .expect-grid {
            display: grid;

            grid-template-columns:
                .8fr 1.2fr;

            gap: 65px;

            align-items: center;
        }

        .expect-image {
            min-height: 500px;

            border-radius: 18px;

            background:
                url("images/project-2.jpg")
                center/cover no-repeat;

            box-shadow: var(--shadow);
        }

        .expect-list {
            list-style: none;

            margin-top: 28px;
        }

        .expect-list li {
            display: flex;

            gap: 14px;

            padding: 15px 0;

            border-bottom:
                1px solid var(--border);

            color: #475467;

            font-weight: 600;
        }


        /* =========================================================
           ROOFING / SIDING
           ========================================================= */

        .additional-section {
            background: var(--off-white);
        }

        .additional-grid {
            display: grid;

            grid-template-columns:
                1fr 1fr;

            gap: 25px;

            margin-top: 45px;
        }

        .additional-card {
            background: white;

            border:
                1px solid var(--border);

            border-radius: 15px;

            padding: 32px;

            border-left:
                5px solid var(--green);
        }

        .additional-card h3 {
            color: var(--dark-blue);

            font-size: 25px;

            margin-bottom: 10px;
        }

        .additional-card p {
            color: var(--gray);

            margin-bottom: 17px;
        }

        .subcontract-note {
            display: inline-block;

            background: var(--green-light);

            color: var(--green-dark);

            padding: 7px 11px;

            border-radius: 5px;

            font-size: 11px;

            font-weight: 900;

            text-transform: uppercase;
        }


        /* =========================================================
           SERVICE AREA
           ========================================================= */

        .area-section {
            background:
                linear-gradient(
                    rgba(247,249,252,.96),
                    rgba(247,249,252,.96)
                );
        }

        .area-box {
            max-width: 850px;

            margin:
                45px auto 0;

            padding: 38px;

            background: white;

            border:
                1px solid var(--border);

            border-radius: 16px;

            text-align: center;

            box-shadow: var(--shadow);
        }

        .area-box h3 {
            color: var(--dark-blue);

            font-size: 29px;

            margin-bottom: 10px;
        }

        .area-box p {
            color: var(--gray);

            margin-bottom: 22px;
        }

        .area-note {
            display: inline-block;

            background: var(--green);

            color: white;

            padding: 10px 20px;

            border-radius: 999px;

            font-size: 14px;

            font-weight: 900;
        }


        /* =========================================================
           REVIEWS
           ========================================================= */

        .reviews-section {
            background: var(--dark-blue);
        }

        .reviews-heading h2 {
            color: white;
        }

        .reviews-heading p {
            color: #C9D6E7;
        }

        .review-rating {
            margin-top: 15px;

            color: #FFD84D;

            font-size: 25px;

            letter-spacing: 3px;
        }

