            } else {

                menu.style.display = "block";

            }

        }


        function closeMobileMenu() {

            document.getElementById(
                "mobileNav"
            ).style.display = "none";

        }


        /*
            Smoothly close the mobile menu when
            the browser returns to desktop size.
        */

        window.addEventListener(
            "resize",
            function() {

                if (window.innerWidth > 850) {

                    document.getElementById(
                        "mobileNav"
                    ).style.display = "none";

                }

            }
        );

